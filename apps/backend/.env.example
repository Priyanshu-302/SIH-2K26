# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/ayur-ip-db

# Redis connection URI
REDIS_URL=redis://localhost:6379

# AI Adapter Mock toggle (set to true to use the mock generator)
AI_ADAPTER_MOCK=false

# Groq API Key
GROQ_API_KEY=gsk_...

# Qdrant DB connection details
QDRANT_URL=http://localhost:6333

# JWT Secret for signing session tokens
JWT_SECRET=ayur_ip_jwt_secure_secret_2026
JWT_EXPIRES_IN=7d

# Brevo (Sendinblue) Email OTP Service
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=your-verified-sender@yourdomain.com
BREVO_SENDER_NAME="Ayur-IP Intelligence"

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
