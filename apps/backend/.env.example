# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB connection URI
MONGODB_URI=mongodb://localhost:27017/ayur-ip-db

# Redis connection URI (used for BullMQ and Rate Limiting)
REDIS_URL=redis://localhost:6379

# AI Adapter Mock toggle (set to true to use the mock generator)
AI_ADAPTER_MOCK=true

# Groq API Key (required when AI_ADAPTER_MOCK=false)
GROQ_API_KEY=your_groq_api_key_here

# Qdrant DB connection details (required when AI_ADAPTER_MOCK=false)
QDRANT_URL=http://localhost:6333
